<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portafolio Dev</title>

    <link rel="stylesheet" href="~/css/7_main/app_base.css" />
</head>
<body>

    <main role="main" class="container-fluid">
        @RenderBody()
    </main>

    <nav id="main-navbar" class="navbar-capsule">
        <div class="navbar-links">
            <a class="nav-item" asp-controller="Home" asp-action="Index">
                @PortFol.Resources.UIText.Navbar_Home
            </a>
            <a class="nav-item" asp-controller="Projects" asp-action="Index">
                @PortFol.Resources.UIText.Navbar_Projects
            </a>
            <a class="nav-item" asp-controller="Stack" asp-action="Index">
                @PortFol.Resources.UIText.Navbar_Stack
            </a>
            <a class="nav-item" asp-controller="About" asp-action="Index">
                @PortFol.Resources.UIText.Navbar_About
            </a>
            <a class="nav-item" asp-controller="Contact" asp-action="Index">
                @PortFol.Resources.UIText.Navbar_Contact
            </a>
        </div>
    </nav>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>